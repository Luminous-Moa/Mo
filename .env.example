# Environment variables the scripts read. Nothing loads this file automatically: set them in the shell
# (PowerShell: $env:CODEX_REMOTE_DATA_DIR = 'D:\CodexRemoteWeb\data') or keep per-machine paths in
# local.settings.json instead (see README "경로 설정"). Order: parameter > environment > local.settings.json > default.
# Paths must be drive-absolute (C:\... or C:/...) or UNC (\\server\share\...).
# Data folder (runtime config, uploads, logs). Default: %LOCALAPPDATA%\CodexRemoteWeb\data
CODEX_REMOTE_DATA_DIR=
# Folder for the initial access password file and the tunnel URL file. Default: the data folder
CODEX_REMOTE_OUTPUT_DIR=
# node.exe used by start.ps1. Default: node on PATH (a shim such as Volta is resolved to the real node.exe)
CODEX_REMOTE_NODE_EXE=
# Not settings: CODEX_REMOTE_CONFIG is set internally by start.ps1 to hand <data folder>\runtime-config.json to
# server.mjs, and CODEX_REMOTE_SETTINGS (a different settings file) exists for tests.
