# Optional runtime overrides. Keep actual values outside this source tree.
CODEX_REMOTE_DATA_DIR=C:\Codex\Apps\CodexRemoteWeb\data
CODEX_REMOTE_CODEX_EXE=C:\Users\YOUR_USER\AppData\Local\OpenAI\Codex\bin\VERSION\codex.exe
